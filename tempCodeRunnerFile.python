import tkinter as tk  # 导入tkinter模块，并简称为tk，用于创建GUI界面

# 创建主窗口
root = tk.Tk()  # 实例化Tk类，创建主窗口对象
root.title("Tkinter 示例")  # 设置窗口标题
root.geometry("500x400")  # 设置窗口大小（宽x高）

# 添加标签
label = tk.Label(
    master=root,           # 父容器
    text="显示文本",       # 标签文本内容
    #textvariable=var,      # 绑定StringVar变量（动态文本）
    font=("Arial", 14),    # 字体设置
    fg="black",            # 文字颜色
    bg="white",            # 背景颜色
    width=20,              # 宽度（字符数）
    height=3,              # 高度（字符数）
    anchor="w",            # 文本对齐：n/s/e/w/ne/nw/se/sw/center
    justify="left",        # 多行文本对齐：left/right/center
    wraplength=100,        # 自动换行宽度（像素）
    #image=photo,           # 显示图像
    compound="top",        # 图文位置关系
    relief="solid",        # 边框样式
    borderwidth=1,         # 边框宽度
    padx=5,                # 水平内边距
    pady=5,                # 垂直内边距
)
label.pack(pady=20)  
# 使用pack几何管理器将标签放置到窗口中：
# - pady=20：在垂直方向添加20像素的外边距
entry = tk.Entry(
    master=root,           # 父容器
    width=30,              # 显示宽度（字符数）
    font=("Arial", 12),    # 字体
    fg="black",            # 文字颜色
    bg="lightyellow",      # 背景颜色
    show="*",              # 显示替代字符（用于密码框）
    state="normal",        # 状态：normal/disabled/readonly
    relief="sunken",       # 边框样式
    borderwidth=2,         # 边框宽度
    #textvariable=var,      # 绑定StringVar变量
    justify="center",      # 文本对齐：left/right/center
    selectbackground="blue",    # 选中文本背景色
    selectforeground="white",   # 选中文本前景色
    insertbackground="red",     # 光标颜色
    insertwidth=2,         # 光标宽度
)
entry.pack()

text_widget = tk.Text(
    master=root,
    width=40,              # 宽度（字符数）
    height=10,             # 高度（行数）
    font=("Consolas", 11), # 字体（等宽字体适合代码）
    fg="black",
    bg="white",
    wrap="word",           # 换行方式：none/char/word
    spacing1=5,            # 段落前间距
    spacing2=2,            # 行间距
    spacing3=5,            # 段落后间距
    tabs=50,               # 制表符宽度
    undo=True,             # 启用撤销功能
    maxundo=-1,            # 撤销步数（-1表示无限制）
    selectbackground="blue",
    selectforeground="white",
    insertbackground="black",
    padx=10,
    pady=10,
)
text_widget.pack()
# 添加按钮
def on_click():
    # 定义按钮点击事件的回调函数
    label.config(text="按钮被点击了！")  
    # 修改标签的文本内容：通过config方法动态更新组件属性
button = tk.Button(
    master=root,           # 父容器（必需）
    text="点击我",         # 按钮显示文本
    command=on_click,      # 点击回调函数（函数名，不加括号）
    width=10,              # 按钮宽度（字符数）
    height=2,              # 按钮高度（字符数）
    font=("Arial", 12),    # 字体设置（字体名, 大小）
    fg="white",            # 前景色（文字颜色）
    bg="blue",             # 背景色
    activeforeground="red", # 激活状态前景色
    activebackground="lightblue", # 激活状态背景色
    state="normal",        # 状态：normal/active/disabled
    cursor="hand2",        # 鼠标悬停光标样式
    relief="raised",       # 边框样式：flat/raised/sunken/groove/ridge
    borderwidth=2,         # 边框宽度
    padx=10,               # 水平内边距
    pady=5,                # 垂直内边距
    # image=photo_image,     # 按钮图像（与text互斥）
    compound="left",       # 图文混合方式：left/right/top/bottom/center
)
button.pack()
# 使用pack几何管理器将按钮放置到窗口中（默认垂直排列）

# 运行主循环
root.mainloop()  
# 启动Tkinter的事件循环：
# - 持续监听用户操作（如点击、键盘输入等）
# - 保持窗口显示，直到用户关闭窗口
# - 这是GUI程序的核心，阻塞在此处等待事件发生